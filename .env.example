# Google Gemini API Configuration
GEMINI_API_KEY="your-gemini-api-key"
TRANSCRIPT_MODEL="gemini-3.8-flash"
TTS_MODEL="gemini-3.1-flash-tts-preview"
STYLE_ANALYZER_MODEL="gemini-3.8-flash"
VIDEO_MODEL="gemini-omni-1.1-flash"

# Shopee Scraper Anti-Bot Cookie Configuration
# Copy your browser cookie string (e.g. from Chrome DevTools -> Application -> Cookies -> shopee.co.th)
# Example: "SPC_F=...; SPC_SI=...; SPC_EC=...; SPC_U=...;"
SHOPEE_COOKIE=""

# Facebook Reels Publishing (Optional / On-Demand)
FB_PAGE_ID="your-facebook-page-id"
FB_PAGE_ACCESS_TOKEN="your-page-access-token"
FB_GRAPH_API_VERSION="v26.0"
AUTO_PUBLISH_REELS="false"
